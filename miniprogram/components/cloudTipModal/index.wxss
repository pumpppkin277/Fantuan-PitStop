/**index.wxss**/

.full_screen_container {
  height: 100vh;
  width: 100vw;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  background-color: #FAF6E8;
  overflow: hidden;
}

.opening_section {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.main_stage {
  position: relative;
  display: flex;
  justify-content: center;
  align-items: center;
  width: 600rpx;
  height: 600rpx;
}

.main_combined_img {
  width: 500rpx;
  height: auto;
  z-index: 2;
  transition: all 0.2s ease;
}

/* 1. 呼吸发光动画 */
.glow_breathing {
  animation: breathingGlow 3s ease-in-out infinite;
}

@keyframes breathingGlow {
  0%, 100% {
    filter: drop-shadow(0 0 10rpx rgba(255, 223, 137, 0.4));
    transform: scale(1);
  }
  50% {
    filter: drop-shadow(0 0 40rpx rgba(255, 223, 137, 0.7));
    transform: scale(1.03);
  }
}

/* 2. 闪光动画 */
.flash_white {
  animation: instantFlash 0.2s ease-out forwards;
}

@keyframes instantFlash {
  0% { filter: brightness(1); }
  50% { filter: brightness(3) drop-shadow(0 0 60rpx #ffffff); transform: scale(1.1); }
  100% { filter: brightness(1); }
}

/* 3. 抖动动画 */
.box_shaking {
  animation: shake 0.1s infinite;
}

@keyframes shake {
  0% { transform: translate(4px, 4px); }
  50% { transform: translate(-4px, -4px); }
  100% { transform: translate(4px, 4px); }
}

.tap_tip_text {
  margin-top: 60rpx;
  font-size: 28rpx;
  color: #8B7E66;
  letter-spacing: 4rpx;
  background: rgba(255, 255, 255, 0.5);
  padding: 15rpx 45rpx;
  border-radius: 50rpx;
  border: 1rpx solid rgba(139, 126, 102, 0.1);
}

.modal_mask {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(0, 0, 0, 0.6); 
  display: flex;
  justify-content: center;
  align-items: center;
  z-index: 999;
  backdrop-filter: blur(10rpx);
}

.modal_content {
  width: 80%;
  background: #fff;
  border-radius: 40rpx;
  overflow: hidden;
  animation: popIn 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
}

@keyframes popIn {
  0% { transform: scale(0.7); opacity: 0; }
  100% { transform: scale(1); opacity: 1; }
}

.treasure_card { padding: 50rpx; text-align: center; }
.treasure_text { font-size: 34rpx; color: #444; line-height: 1.6; display: block; margin-bottom: 30rpx; }
.treasure_image { width: 100%; border-radius: 20rpx; margin-bottom: 30rpx; }
.treasure_footer { border-top: 1rpx solid #eee; padding-top: 30rpx; display: flex; justify-content: space-between; }
.treasure_tag { color: #999; font-size: 24rpx; }
.close_link { color: #8B7E66; font-weight: bold; font-size: 26rpx; }